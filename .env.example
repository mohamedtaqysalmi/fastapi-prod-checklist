# Copy to .env for local development. Every variable has the APP_ prefix.

# Required. One of: local, staging, production. There is no default on purpose.
APP_ENVIRONMENT=local

# Optional, shown with their defaults.
APP_DEBUG=false
APP_LOG_LEVEL=INFO
# Comma-separated list or a JSON array. Empty means CORS is not enabled.
APP_CORS_ALLOW_ORIGINS=
APP_CORS_ALLOW_CREDENTIALS=false
APP_CORS_ALLOW_METHODS=GET
APP_READINESS_TIMEOUT_SECONDS=2

# Rate limiting (fixed window, per client IP / X-Forwarded-For).
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_REQUESTS=60
APP_RATE_LIMIT_WINDOW_SECONDS=60
# Reverse proxies in front of the app that append to X-Forwarded-For. 0 ignores the header,
# which is the safe choice when clients connect directly.
APP_TRUSTED_PROXY_HOPS=0

# Sentry is off unless a DSN is set.
APP_SENTRY_DSN=
APP_SENTRY_TRACES_SAMPLE_RATE=0

# Async SQLAlchemy URL. Empty means no engine is created at startup.
# Example: sqlite+aiosqlite:///./app.db
APP_DATABASE_URL=
# When true, /readyz runs SELECT 1 against the configured database.
APP_DATABASE_READY_CHECK=false

# Seconds to wait for in-flight requests on shutdown before disposing resources.
APP_SHUTDOWN_GRACE_SECONDS=5
